{
  "name": "knolcam",
  "version": "0.1.0",
  "private": true,
  "description": "Offline classroom document camera",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.knolquiz.webcam",
    "productName": "KnolCam",
    "files": [
      "index.html",
      "app.js",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "KnolCam-${version}-portable.${ext}"
    }
  }
}